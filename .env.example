# Server Configurations
PORT=5001
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/ai-website-builder

# Security Configuration
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=30d

# GRIP admin mobile numbers (comma-separated)
GRIP_ADMIN_MOBILES=9988776655,9944270374,9551205555

# Cloudflare Configuration (Optional - falls back to mock modes if left empty)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_KV_NAMESPACE_ID=

# Cloudflare R2 configurations (Optional - falls back to local storage)
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_PUBLIC_URL=http://localhost:5002/uploads

# GRIP Proud Associate badge (Cloudinary)
GRIP_LOGO_URL=https://res.cloudinary.com/dexrm9ve9/image/upload/v1784109653/ai-website-builder/grip-proud-associate-logo.png
